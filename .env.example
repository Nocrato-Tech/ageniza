# Supported runtimes: local (or development), test/CI, and production only.
# `develop` is a Git branch, not a runtime; staging is intentionally unsupported.
APP_ENV=local

# API / worker (server only - never prefix these with VITE_)
BETTER_AUTH_SECRET=local-development-placeholder-secret-change-me
APP_PUBLIC_URL=http://127.0.0.1:5173
AUTH_TERMS_VERSION=2026-01-01
AUTH_PRIVACY_VERSION=2026-02-01
API_HOST=0.0.0.0
PORT=3001
# Comma-separated browser origins permitted to call the API. Never use '*'.
API_CORS_ORIGINS=http://127.0.0.1:5173
# Limit parsed request bodies (1 MiB by default). Keep uploads on dedicated routes with an explicit limit.
API_BODY_LIMIT_BYTES=1048576
# Comma-separated CIDRs/IPs for known reverse proxies. Empty means ignore X-Forwarded-* headers.
API_TRUSTED_PROXY_CIDRS=
# Local PostgreSQL from compose.yml (`pnpm db:start`). The application role cannot bypass RLS.
DATABASE_URL=postgresql://ageniza_app:ageniza_app@127.0.0.1:54322/ageniza
# Owner role for `pnpm db:migrate` and database tests only; never give it to the API or worker.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/ageniza
# Transactional email. Set both or neither; Mailpit captures everything locally (pnpm docker:up).
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=Ageniza <no-reply@ageniza.local>
# Optional production server-side error tracking. Leave unset to disable; never prefix with VITE_.
SENTRY_DSN=
# Release identifier recorded in logs and Sentry (for example, an immutable image tag or commit SHA).
APP_VERSION=unknown
# Worker probes bind only to loopback and are never published externally.
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3002
# Deterministic local/CI bootstrap check. Production configuration rejects true.
WORKER_SMOKE_JOB=false
# Durable queue jobs processed at once (1-4). CPU-heavy ffmpeg work has its own per-queue
# concurrency of 1, so this global ceiling can preserve throughput for lighter jobs.
WORKER_CONCURRENCY=1
# Video processing (issue #24): thumbnail + 720p preview, generated by the worker's ffmpeg after
# an upload is confirmed. ffmpeg/ffprobe invocation timeout (seconds); a stuck process is killed.
MEDIA_PROCESSING_TIMEOUT_SECONDS=240
# A video probed longer than this fails explicitly instead of being processed.
MEDIA_PROCESSING_MAX_DURATION_SECONDS=1800
MEDIA_THUMBNAIL_WIDTH_PIXELS=640
MEDIA_PREVIEW_MAX_HEIGHT_PIXELS=720
# Hard cap on the encoded preview file, passed to ffmpeg's own -fs; guards local disk.
MEDIA_PREVIEW_MAX_OUTPUT_BYTES=314572800
# Object storage (issue #21): MinIO locally (pnpm docker:up), Cloudflare R2 in production. All four
# required together; leave unset only when nothing exercises the media module.
R2_ENDPOINT=http://127.0.0.1:9000
# Only needed when the API itself runs inside the Compose network (see compose.yml); the browser
# always needs a host-reachable endpoint. Defaults to R2_ENDPOINT when unset.
# R2_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# Local MinIO credentials are generated into the ignored `.local/storage.env` by
# `pnpm storage:start`; never commit storage keys here.
R2_BUCKET=ageniza-media-local
# R2 ignores this (always "auto"); MinIO accepts any non-empty region.
R2_REGION=auto
# Path-style addressing works for both MinIO and R2 without per-bucket DNS.
R2_FORCE_PATH_STYLE=true
# Presigned PUT/part URL lifetime (seconds). The client re-requests a fresh URL on expiry (resumable multipart).
MEDIA_UPLOAD_URL_EXPIRY_SECONDS=900
# Presigned GET lifetime (seconds), issued only when a social network fetches the file to publish.
MEDIA_DOWNLOAD_URL_EXPIRY_SECONDS=300
# Files at or above this size use multipart upload instead of one presigned PUT.
MEDIA_MULTIPART_THRESHOLD_BYTES=8388608
# Size of every multipart part except the last (must be >= 5 MiB and <= the threshold above).
MEDIA_MULTIPART_PART_BYTES=8388608
MEDIA_MAX_BYTES_IMAGE=26214400
MEDIA_MAX_BYTES_VIDEO=5368709120
# Default per-tenant quota; an agency row in agency_storage_quotas may override it.
STORAGE_QUOTA_DEFAULT_BYTES=10737418240
STORAGE_QUOTA_DEFAULT_OBJECT_COUNT=2000

# Web (the only values embedded into the browser bundle)
VITE_API_BASE_URL=http://127.0.0.1:3001
# Temporary: removed with the Supabase web client in issue #20.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-placeholder
# Optional public Sentry DSN. This DSN is intentionally public; never put credentials in VITE_ variables.
VITE_SENTRY_DSN=
VITE_APP_VERSION=unknown
