APP_ENV=production
BETTER_AUTH_SECRET=replace-with-at-least-32-character-production-secret
APP_PUBLIC_URL=https://app.example.com
AUTH_TERMS_VERSION=2026-01-01
AUTH_PRIVACY_VERSION=2026-02-01
DATABASE_URL=postgresql://ageniza_app:REPLACE_WITH_APPLICATION_PASSWORD@postgres:5432/ageniza
API_CORS_ORIGINS=https://app.example.com
API_TRUSTED_PROXY_CIDRS=REPLACE_WITH_AGENIZA_PRODUCTION_PROXY_SUBNET
WORKER_SMOKE_JOB=false
WORKER_CONCURRENCY=1
SMTP_URL=smtps://REPLACE_WITH_PROVIDER_USER:REPLACE_WITH_PROVIDER_KEY@smtp.example.com:465
EMAIL_FROM=Ageniza <no-reply@example.com>
SENTRY_DSN=
# Cloudflare R2 (issue #21). Create the bucket, an R2 API token scoped to it, and the bucket's
# CORS/lifecycle configuration by hand (see apps/api/src/modules/media/README.md); none of that is
# expressible as a Knex migration or Docker Compose file.
R2_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET=REPLACE_WITH_R2_BUCKET_NAME
R2_REGION=auto
R2_FORCE_PATH_STYLE=true
MEDIA_UPLOAD_URL_EXPIRY_SECONDS=900
MEDIA_DOWNLOAD_URL_EXPIRY_SECONDS=300
MEDIA_MULTIPART_THRESHOLD_BYTES=8388608
MEDIA_MULTIPART_PART_BYTES=8388608
MEDIA_MAX_BYTES_IMAGE=26214400
MEDIA_MAX_BYTES_VIDEO=5368709120
STORAGE_QUOTA_DEFAULT_BYTES=10737418240
STORAGE_QUOTA_DEFAULT_OBJECT_COUNT=2000
# Identity storage (issue #100): a SECOND R2 bucket, distinct from the media bucket above, with
# its own API token scoped to only that bucket. Create it by hand, same as the media bucket -- see
# apps/api/src/modules/identity-storage/README.md.
IDENTITY_STORAGE_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
IDENTITY_STORAGE_ACCESS_KEY_ID=REPLACE_WITH_IDENTITY_R2_ACCESS_KEY_ID
IDENTITY_STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_IDENTITY_R2_SECRET_ACCESS_KEY
IDENTITY_STORAGE_BUCKET=REPLACE_WITH_IDENTITY_R2_BUCKET_NAME
IDENTITY_STORAGE_REGION=auto
IDENTITY_STORAGE_FORCE_PATH_STYLE=true
IDENTITY_DOWNLOAD_URL_EXPIRY_SECONDS=300
IDENTITY_MAX_IMAGE_BYTES=5242880
# Video processing (issue #24): the worker's ffmpeg generates a thumbnail and a 720p preview from
# each confirmed video, using the same R2_* credentials above (both api and worker read this file).
MEDIA_PROCESSING_TIMEOUT_SECONDS=240
MEDIA_PROCESSING_MAX_DURATION_SECONDS=1800
MEDIA_THUMBNAIL_WIDTH_PIXELS=640
MEDIA_PREVIEW_MAX_HEIGHT_PIXELS=720
MEDIA_PREVIEW_MAX_OUTPUT_BYTES=314572800
