# Copy outside this repository and set the real public key before running.
# This file is sourced by Bash; keep values shell-safe and do not store secrets here.
DEPLOY_USER=ageniza
SSH_PORT=22
DEPLOY_PUBLIC_KEY='ssh-ed25519 REPLACE_WITH_A_REAL_PUBLIC_KEY deploy@admin-workstation'

# The Docker group is effectively root-equivalent. Keep this false unless an
# approved deployment design explicitly requires passwordless Docker access.
ADD_DEPLOY_USER_TO_DOCKER_GROUP=false

# Set only on a verified, clean host. It resets UFW and leaves exactly SSH,
# HTTP, and HTTPS inbound rules. The default preserves existing UFW rules.
LOCKDOWN_UFW=true
