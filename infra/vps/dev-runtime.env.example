# Shape of /etc/ageniza-dev/runtime.env. Copy WITHOUT the comment lines: the deploy script accepts KEY=value lines only.
# Nothing here may be a production value: a different BETTER_AUTH_SECRET, its own R2 buckets and tokens, its own database.
# SMTP_URL, EMAIL_FROM, DEPLOY_TARGET and API_TRUSTED_PROXY_CIDRS must NOT appear: compose.dev.yml fixes them (mail only
# reaches the Mailpit sink) and the deploy script refuses a file that names them.
APP_ENV=production
BETTER_AUTH_SECRET=replace-with-a-dev-only-secret-of-at-least-32-characters
APP_PUBLIC_URL=https://dev.ageniza.com.br
API_CORS_ORIGINS=https://dev.ageniza.com.br
AUTH_TERMS_VERSION=2026-01-01
AUTH_PRIVACY_VERSION=2026-02-01
DATABASE_URL=postgresql://ageniza_app:REPLACE_WITH_DEV_APPLICATION_PASSWORD@postgres:5432/ageniza
# The payment provider of the dev environment is always the simulated one (the provider itself comes with the plans work).
PAYMENTS_PROVIDER=simulado
WORKER_SMOKE_JOB=false
WORKER_CONCURRENCY=1
SENTRY_DSN=
SUPPORT_CONTACT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
API_PUBLIC_URL=
MOBILE_APP_ORIGINS=
# Cloudflare R2, dev buckets only (the names must contain "dev"), each with an API token scoped to that bucket alone.
R2_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_WITH_DEV_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_DEV_R2_SECRET_ACCESS_KEY
R2_BUCKET=ageniza-media-dev
R2_REGION=auto
R2_FORCE_PATH_STYLE=true
MEDIA_UPLOAD_URL_EXPIRY_SECONDS=900
MEDIA_DOWNLOAD_URL_EXPIRY_SECONDS=300
MEDIA_MULTIPART_THRESHOLD_BYTES=8388608
MEDIA_MULTIPART_PART_BYTES=8388608
MEDIA_MAX_BYTES_IMAGE=26214400
MEDIA_MAX_BYTES_VIDEO=1073741824
STORAGE_QUOTA_DEFAULT_BYTES=2147483648
STORAGE_QUOTA_DEFAULT_OBJECT_COUNT=500
IDENTITY_STORAGE_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
IDENTITY_STORAGE_ACCESS_KEY_ID=REPLACE_WITH_DEV_IDENTITY_R2_ACCESS_KEY_ID
IDENTITY_STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_DEV_IDENTITY_R2_SECRET_ACCESS_KEY
IDENTITY_STORAGE_BUCKET=ageniza-identity-dev
IDENTITY_STORAGE_REGION=auto
IDENTITY_STORAGE_FORCE_PATH_STYLE=true
IDENTITY_DOWNLOAD_URL_EXPIRY_SECONDS=300
IDENTITY_MAX_IMAGE_BYTES=5242880
MEDIA_PROCESSING_TIMEOUT_SECONDS=240
MEDIA_PROCESSING_MAX_DURATION_SECONDS=900
MEDIA_THUMBNAIL_WIDTH_PIXELS=640
MEDIA_PREVIEW_MAX_HEIGHT_PIXELS=720
MEDIA_PREVIEW_MAX_OUTPUT_BYTES=157286400
