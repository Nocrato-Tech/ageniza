{
	# Loopback-only inside the container; ageniza-deploy needs it for `caddy reload`.
	admin localhost:2019
	auto_https disable_redirects
	servers {
		# Real client IP for rate limiting: trust CF-Connecting-IP only from Cloudflare ranges,
		# generated by ageniza-refresh-cloudflare-ips.
		import /etc/caddy/cloudflare-trusted-proxies.caddy
		client_ip_headers CF-Connecting-IP
	}
}

http://{$AGENIZA_DOMAIN} {
	redir https://{host}{uri} permanent
}

https://{$AGENIZA_DOMAIN} {
	tls /etc/caddy/tls/origin.crt /etc/caddy/tls/origin.key {
		# Cloudflare Authenticated Origin Pulls: only Cloudflare can complete the TLS handshake,
		# because Docker-published ports bypass UFW source-IP rules.
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/tls/cloudflare-origin-pull-ca.pem
		}
	}
	import /etc/caddy/active-upstream.caddy
}
