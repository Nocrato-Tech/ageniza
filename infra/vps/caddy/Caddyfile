{
	# Let's Encrypt account contact; certificates are issued and renewed automatically.
	email {$AGENIZA_ACME_EMAIL}
	servers {
		# Real client IP for rate limiting: trust CF-Connecting-IP only from Cloudflare ranges,
		# generated by ageniza-refresh-cloudflare-ips.
		import /etc/caddy/cloudflare-trusted-proxies.caddy
		client_ip_headers CF-Connecting-IP
	}
}

{$AGENIZA_DOMAIN} {
	handle_path /api/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:8080
	}
}
