{
  "name": "@ageniza/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node bin/migrate.mjs",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run test/postgres.integration.test.ts test/rls-coverage.integration.test.ts test/tenancy.integration.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "knex": "3.1.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5"
  }
}
