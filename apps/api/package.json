{
  "name": "@ageniza/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/test-support/**"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=../../.env --env-file=../../.local/storage.env src/index.ts",
    "cli:agency": "node dist/cli/agency.js",
    "cli:email-change": "node dist/cli/email-change.js",
    "api:docs": "tsx src/cli/api-docs.ts",
    "seed:demo": "tsx src/cli/seed-demo.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "pretest:integration": "pnpm exec turbo run build --filter=@ageniza/api^...",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ageniza/config": "workspace:*",
    "@ageniza/contracts": "workspace:*",
    "@ageniza/core": "workspace:*",
    "@ageniza/database": "workspace:*",
    "@ageniza/email": "workspace:*",
    "@ageniza/payments": "workspace:*",
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "3.1140.0",
    "@better-auth/expo": "1.7.7",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "better-auth": "1.7.7",
    "fastify": "^5.12.5",
    "helmet": "^8.3.0",
    "kysely": "0.29.6",
    "pg": "8.16.3",
    "pg-boss": "12.30.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@scalar/fastify-api-reference": "^1.72.2",
    "@types/pg": "8.15.5",
    "tsx": "^4.19.3"
  }
}
