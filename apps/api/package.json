{
  "name": "@ageniza/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env --env-file=../../.local/storage.env watch src/index.ts",
    "cli:agency": "node dist/cli/agency.js",
    "api:docs": "tsx src/cli/api-docs.ts",
    "seed:demo": "tsx src/cli/seed-demo.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts src/modules/auth/auth.integration.test.ts src/modules/auth/auth-rate-limit.integration.test.ts src/modules/auth/auth-schema.integration.test.ts src/modules/auth/auth-logs.integration.test.ts src/modules/invitations/invitations.integration.test.ts src/modules/contexts/contexts.integration.test.ts src/modules/agencies/agencies.integration.test.ts src/modules/api-docs/api-docs.integration.test.ts src/modules/media/media.integration.test.ts src/modules/identity-storage/identity-storage.integration.test.ts src/cli/seed-demo.integration.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ageniza/config": "workspace:*",
    "@ageniza/contracts": "workspace:*",
    "@ageniza/core": "workspace:*",
    "@ageniza/database": "workspace:*",
    "@ageniza/email": "workspace:*",
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "better-auth": "1.7.5",
    "fastify": "^5.2.1",
    "kysely": "0.29.6",
    "pg": "8.16.3",
    "pg-boss": "12.30.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@scalar/fastify-api-reference": "^1.72.2",
    "@types/pg": "8.15.5",
    "tsx": "^4.19.3"
  }
}
