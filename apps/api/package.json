{
  "name": "@ageniza/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env watch src/index.ts",
    "cli:agency": "node dist/cli/agency.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ageniza/config": "workspace:*",
    "@ageniza/contracts": "workspace:*",
    "@ageniza/core": "workspace:*",
    "@ageniza/database": "workspace:*",
    "@ageniza/email": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "better-auth": "1.7.5",
    "fastify": "^5.2.1",
    "kysely": "0.29.6",
    "pg": "8.16.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "tsx": "^4.19.3"
  }
}
