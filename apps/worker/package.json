{
  "name": "@ageniza/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env --env-file=../../.local/storage.env watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ageniza/config": "workspace:*",
    "@ageniza/contracts": "workspace:*",
    "@ageniza/core": "workspace:*",
    "@ageniza/database": "workspace:*",
    "@aws-sdk/client-s3": "3.700.0",
    "pg-boss": "12.30.0"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
