{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @ageniza/contracts build && pnpm --filter @ageniza/mobile exec expo export --platform web --output-dir web-dist",
  "outputDirectory": "web-dist",
  "redirects": [
    { "source": "/", "destination": "https://dev.ageniza.com.br/app-mobile/", "permanent": false },
    { "source": "/apresentacao", "destination": "https://dev.ageniza.com.br/app-mobile/", "permanent": false },
    { "source": "/apresentacao/", "destination": "https://dev.ageniza.com.br/app-mobile/", "permanent": false },
    { "source": "/apresentacao/:path*", "destination": "https://dev.ageniza.com.br/app-mobile/", "permanent": false }
  ]
}
